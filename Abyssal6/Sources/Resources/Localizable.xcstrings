    "room_air" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie befinden sich in der äußeren Schleuse.\nEine schwere Stahltür führt in die Tiefsee. Sie spüren das Brüllen des Drucks."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are in the outer airlock.\nA heavy steel door leads into the deep sea. You feel the roar of pressure."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes dans le sas extérieur.\nUne lourde porte en acier mène vers les profondeurs marines. Vous sentez le rugissement de la pression."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在外部气闸中。\n一扇沉重的钢门通向深海。你感受到压力的轰鸣。"
          }
        }
      }
    },
    "room_dortoir" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie befinden sich in der Crew-Unterkunft.\nBetten sind umgestürzt und persönliche Gegenstände treiben im kalten Wasser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are in the crew quarters.\nBeds are overturned and personal effects float in cold water."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes dans les quartiers de l'équipage.\nLes lits sont renversés et les effets personnels flottent dans l'eau froide."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在船员宿舍中。\n床铺被掀翻，个人物品漂浮在冷水中。"
          }
        }
      }
    },
    "room_eng" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie befinden sich im Hilfsmaschinenraum.\nDer Boden vibriert stark; eine Dampfleitung ist geplatzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are in the auxiliary engine room.\nThe floor vibrates heavily; a steam pipe has burst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes dans la salle des machines auxiliaire.\nLe sol vibre fortement ; une conduite de vapeur a éclaté."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在辅助引擎室中。\n地板剧烈震动；一根蒸汽管爆裂了。"
          }
        }
      }
    },
    "room_hydro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
