        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich überprüfe die Strahlungswerte entlang meiner Route... alles scheint vorerst stabil zu sein. Bewegt euch weiter, Überlebender."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
