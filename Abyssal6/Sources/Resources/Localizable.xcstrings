      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich kann Ihnen eine rote Karte im Austausch für diesen Verbandskasten geben. Die medizinischen Vorräte sind entscheidend für meine Forschung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I can give you a red card in exchange for that first aid kit. The medical supplies are critical for my research."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je peux vous donner une carte rouge en échange de cette trousse de secours. Les fournitures médicales sont essentielles pour ma recherche."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我可以给你一张红卡，交换那个急救包。医疗用品对我的研究至关重要。"
          }
        }
      }
    },
    "character_geneticist_greeting" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faszinierend... die hydroponischen Pflanzen zeigen seltsame Mutationen durch den Tiefseedruck. Haben Sie etwas Interessantes gesehen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fascinating... the hydroponic plants are showing strange mutations from the deep-sea pressure. Have you seen anything interesting?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fascinant... les plantes hydroponiques montrent d'étranges mutations dues à la pression des profondeurs. Avez-vous vu quelque chose d'intéressant ?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "迷人……水培植物因深海压力而出现奇怪的突变。你看到什么有趣的东西了吗？"
          }
        }
      }
    },
