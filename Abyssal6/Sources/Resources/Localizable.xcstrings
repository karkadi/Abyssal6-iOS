    "welcome" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--- SYSTEM-ALARM: ABYSSAL-STATION-6 ---\nEin abyssaler Sturm hat die Struktur beschädigt.\nAls Wartungsingenieur ist Ihre Mission entscheidend:\nStabilisieren Sie den Reaktor, bevor der Druck uns zerquetscht!\n\nGeben Sie 'help' ein, wenn Sie Hilfe benötigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--- SYSTEM ALERT: ABYSSAL-STATION-6 ---\nAn abyssal storm has damaged the structure.\nAs maintenance engineer your mission is vital:\nStabilize the reactor before the pressure crushes us!\n\nType 'help' if you need assistance."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--- ALERTE SYSTÈME : STATION ABYSSALE-6 ---\nUne tempête abyssale a endommagé la structure.\nEn tant qu'ingénieur de maintenance, votre mission est vitale :\nStabilisez le réacteur avant que la pression ne nous écrase !\n\nTapez 'help' si vous avez besoin d'aide."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--- 系统警报：深渊空间站-6 ---\n一场深渊风暴损坏了结构。\n作为维修工程师，您的使命至关重要：\n在压力压垮我们之前稳定反应堆！\n\n如需帮助，请键入 'help'。"
          }
        }
      }
    },
