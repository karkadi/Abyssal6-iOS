    "character_doctor_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schiffsarzt, kann Verletzungen heilen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ship's doctor, can heal injuries"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Médecin du navire, peut soigner les blessures"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "船医，可以治疗伤势"
          }
        }
      }
    },
    "character_doctor_exchange" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich kann Ihnen ein Superkraft-Elixier im Austausch für Sauerstoff geben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I can give you a super-strength elixir in exchange for oxygen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je peux vous donner un élixir de super-force en échange d'oxygène."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我可以给你一个超强力量药水，交换氧气。"
          }
        }
      }
    },
    "character_doctor_greeting" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind Sie verletzt? Setzen Sie sich, lassen Sie mich Sie untersuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you injured? Sit down, let me examine you."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Êtes-vous blessé ? Asseyez-vous, laissez-moi vous examiner."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你受伤了吗？坐下，让我检查一下。"
          }
        }
      }
    },
    "character_engineer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingenieur Martinez"
          }
        },
        "en" : {
