      }
    },
    "character_engineer_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemingenieur, kennt die Station wie seine Westentasche"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System engineer, knows the station like the back of his hand"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingénieur système, connaît la station sur le bout des doigts"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统工程师，对空间站了如指掌"
          }
        }
      }
    },
    "character_engineer_exchange" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich kann Ihnen einen Tauchanzug im Austausch für diese genetische Probe geben. Ich muss diese Tiefseeorganismen untersuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I can give you a diving suit in exchange for that genetic sample. I need to study those deep-sea organisms."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je peux vous donner une combinaison de plongée en échange de cet échantillon génétique. J'ai besoin d'étudier ces organismes des profondeurs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我可以给你一套潜水服，交换那个基因样本。我需要研究那些深海生物。"
          }
        }
      }
    },
    "character_engineer_greeting" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein weiterer Überlebender? Das Gewächshaus hält noch... vorerst. Die Pflanzen sind unsere einzige Sauerstoffquelle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another survivor? The greenhouse is still holding... for now. The plants are our only source of oxygen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un autre survivant ? La serre tient toujours... pour l'instant. Les plantes sont notre seule source d'oxygène."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "又一个幸存者？温室目前还撑得住……植物是我们唯一的氧气来源。"
          }
        }
      }
    },
    "character_enters" : {
